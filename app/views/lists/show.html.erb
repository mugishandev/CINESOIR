<div class="container col-8">
  <div class="p-3">
    <h1 class="text-center"><%= @list.name %></h1>
  </div>

  <div>
    <%= simple_form_for [@list, @marker] do |f| %>
      <div class="d-flex align-items-center gap-2">
        <div class="flex-grow-1">
          <%= f.association :movie, label: "Choisir un film :", label_html: {class: "fw-bold"} %>
        </div>
        <%= f.button :submit, "Ajouter à la liste", class: "btn btn-success rounded-2 text-white fw-bold mt-3" %>
      </div>
    <% end %>
  </div>
  <div>
    <ul class="movie-grid">
      <% @list.movies.each do |movie| %>
        <li class="movie-card mt-2">
          <div class="movie-info">
            <h2><%= movie.title %></h2>
            <div class="movie-details">
            <p><%= movie.genre %></p>
            <p><%= movie.year %></p>
            </div>
          </div>
          <div class="movie-synopsis">
            <p><%= movie.synopsis %></p>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="d-flex justify-content-between">
    <%= button_to "Détruire la liste", @list, method: :delete, class: "btn btn-danger fw-bold text-white" %>
    <%= button_to "Retour au menu", lists_path, class: "btn btn-primary fw-bold" %>
  </div>
</div>
