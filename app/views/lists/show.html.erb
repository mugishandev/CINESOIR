<h1><%= @list.name %></h1>
<%= simple_form_for [@list, @marker] do |f| %>
  <%= f.association :movie %>
  <%= f.submit %>
<% end %>
<ul>
 <%= @list.movies.each do |movie| %>
  <li>
    <h2><%= movie.title %></h2>
    <p><%= movie.genre %></p>
    <p><%= movie.year %></p>
    <p><%= movie.synopsis %></p>
    </li>
 <% end %>
</ul>
<%= button_to "Destroy this list", @list, method: :delete %>
<%= link_to "Back to lists", lists_path %>
