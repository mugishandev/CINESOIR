<div class="container-fluid">
  <p class="text-center p-3">
    <!-- Voici notre landing page, impressionnante n'est-ce pas ? -->
  </p>

  <div class="row p-3">

    <div class="col-3 text-center  border border-light rounded p-3">
      <h3><%= link_to "Mes Chats", chats_path %></h3>
        <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <!-- <li><%#= link_to chat.title, chat_path(chat) %></li> -->
          <% end %>
        </ul>
      <% else %>
        There are no chats yet.
      <% end %>
    </div><!-- <h3>Mes Chats</h3> -->


    <div class="col-6 text-center border border-light rounded p-3">
      <h3>Chatbot</h3>
      <%= simple_form_for [@chat, @message] do |f| %>
          <label for="message" class="form-label">Voici la réponse du chatbot, passionnant n'est-il pas ?</label>
          <%= f.input :content,
          label: "Posez votre question...?" %>
          <%= f.submit "envoyer", class: "btn btn primary" %>
      <% end %>
    </div>

    <div class="col-3 text-center  border border-light rounded p-3">
      <h3>Mes listes</h3>
      <div>
        <% @lists.each do |list| %>
          <p>
            <%= link_to list.name, list_path(list) %>
          </p>
        <% end %>
        <%= button_to "Nouvelle liste", new_list_path, method: :get, class: "btn btn-success text-white fw-bold" %>
      </div>
    </div>
  </div>
</div>
