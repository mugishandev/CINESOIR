<div class="container-fluid">
  <p class="text-center p-3">
    <!-- Voici notre landing page, impressionnante n'est-ce pas ? -->
  </p>

  <div class="row p-3">

    <div class="col-3 text-center  border border-light rounded p-3">
      <h3>Historique</h3>
        <% if @chats.any? %>
          <% @chats.each do |chat| %>
            <div>
            <%= link_to chat.title, chat_path(chat), class: "text-decoration-none" %>
            </div>
          <% end %>
        <% else %>
          Aucun échange, pour l'instant.
        <% end %>
    </div><!-- <h3>Mes Chats</h3> -->


    <div class="col-6 text-center border border-light rounded p-3">
      <h3>Chatbot</h3>
      <%#= simple_form_for [@chat, @message] do |f| %>
      <%= simple_form_for @message, url: chats_path do |f| %>
          <label for="message" class="form-label"></label>
          <%= f.input :content,
          label: "Que voulez vous voir ce soir?" %>
          <%= f.submit "envoyer", class: "btn btn primary" %>
      <% end %>
    </div>

    <div class="col-3 text-center  border border-light rounded p-3">
      <h3>Mes listes</h3>
      <div>
        <% @lists.each do |list| %>
          <p class="text-decoration-none">
            <%= link_to list.name, list_path(list) %>
          </p>
        <% end %>
        <%= button_to "Nouvelle liste", new_list_path, method: :get, class: "btn btn-success text-white fw-bold" %>
      </div>
    </div>
  </div>
</div>
