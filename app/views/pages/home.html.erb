  <div class="row p-3">

    <div class="col-3 text-center  border border-light rounded p-3">
      <h3>Mes Chats</h3>
        <% if @chats.any? %>
          <% @chats.each do |chat| %>
            <div>
            <%= link_to chat.title, chat_path(chat) %>
            </div>
          <% end %>
        <% else %>
          There are no chats yet.
        <% end %>
    </div><!-- <h3>Mes Chats</h3> -->


