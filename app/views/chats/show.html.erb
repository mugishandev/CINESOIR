<!-- <h1 id="chat_title"><%#= @chat.title %></h1> -->

<% @chat.messages.each do |message| %>
  <p>
    <strong><%= message.role %></strong>
    <%= simple_format(message.content) %>
  </p>
<% end %>

<div id="new_message_container">
  <%= simple_form_for [@chat, @message] do |f| %>
    <%= f.input :content, label: "Ask a question", required: true, placeholder: "Que voulez vous voir ce soir?" %>
    <%= f.button :submit, 'Ask LLM', class: 'btn btn-primary' %>
    <%= link_to "Back to home", root_path %>
  <% end %>

  <%= button_to "Destroy this Chat", @chat, method: :delete %>

</div>
